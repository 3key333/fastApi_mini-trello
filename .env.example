# Скопируй в .env и при необходимости поправь значения:
#   copy .env.example .env

# Postgres через Docker (порт 5433 на хосте — чтобы не конфликтовать с локальным 5432)
DATABASE_URL=postgresql+asyncpg://trello:trello@127.0.0.1:5433/mini_trello

# Подпись JWT. В проде — длинный случайный секрет, только из .env
JWT_SECRET_KEY=dev-change-me-to-something-secure-in-prod

# Опционально (есть дефолт в config.py):
# JWT_ACCESS_EXPIRES_MINUTES=60
# APP_NAME=Mini Trello

# Откуда можно ходить на API (фронт). Несколько через запятую.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
